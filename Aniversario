<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>
Un mes más contigo ❤️
</title>


<style>

/* =========================
   CONFIGURACIÓN GENERAL
========================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{

    min-height:100vh;

    background:
    radial-gradient(
        circle at top,
        #68182d,
        #260812 55%,
        #080207
    );

    color:white;

    font-family:Georgia, serif;

    overflow-x:hidden;

}


/* =========================
   LUCES
========================= */

.luces{

    position:fixed;

    inset:0;

    pointer-events:none;

    z-index:0;

}


.luz{

    position:absolute;

    width:6px;

    height:6px;

    background:#ffd86b;

    border-radius:50%;

    box-shadow:
        0 0 10px #ffd86b,
        0 0 25px #ff9d00;

    animation:
        brillar 2s infinite alternate;

}


.luz:nth-child(1){
    top:8%;
    left:10%;
}

.luz:nth-child(2){
    top:15%;
    left:80%;
    animation-delay:.4s;
}

.luz:nth-child(3){
    top:30%;
    left:5%;
    animation-delay:.8s;
}

.luz:nth-child(4){
    top:45%;
    left:93%;
    animation-delay:1s;
}

.luz:nth-child(5){
    top:70%;
    left:8%;
    animation-delay:1.3s;
}

.luz:nth-child(6){
    top:85%;
    left:90%;
    animation-delay:.6s;
}

.luz:nth-child(7){
    top:55%;
    left:15%;
    animation-delay:1.5s;
}

.luz:nth-child(8){
    top:25%;
    left:90%;
    animation-delay:1.8s;
}


@keyframes brillar{

    from{
        opacity:.3;
        transform:scale(.7);
    }

    to{
        opacity:1;
        transform:scale(1.4);
    }

}


/* =========================
   CONTENEDOR
========================= */

.contenedor{

    position:relative;

    z-index:2;

    width:100%;

    max-width:650px;

    margin:auto;

    padding:
        35px
        18px
        60px;

    text-align:center;

}


/* =========================
   TITULO
========================= */

.titulo{

    font-size:40px;

    color:#ffd5dc;

    text-shadow:
        0 0 8px #ff5c7a,
        0 0 20px #ff174d;

    animation:
        latido 2s infinite;

}


.subtitulo{

    margin-top:10px;

    font-size:23px;

    color:#ffe9a6;

}


@keyframes latido{

    0%,100%{
        transform:scale(1);
    }

    50%{
        transform:scale(1.04);
    }

}


/* =========================
   CORAZÓN
========================= */

.corazon{

    font-size:55px;

    margin:
        12px
        0;

    animation:
        corazon 1.2s infinite;

    filter:
        drop-shadow(
            0 0 12px #ff174d
        );

}


@keyframes corazon{

    0%,100%{
        transform:scale(1);
    }

    50%{
        transform:scale(1.25);
    }

}


/* =========================
   MARCO DE LA FOTO
========================= */

.marco{

    position:relative;

    margin:
        25px
        auto;

    width:92%;

    max-width:500px;

    padding:10px;

    background:

        linear-gradient(
            135deg,
            #fff2b2,
            #d49b37,
            #fff1a8,
            #9b621d
        );

    border-radius:25px;

    box-shadow:

        0 0 15px #ffd36b,

        0 0 35px
        rgba(255,150,40,.7),

        0 20px 50px
        rgba(0,0,0,.7);

}


/* =========================
   FOTO
========================= */

.foto{

    width:100%;

    height:auto;

    display:block;

    border-radius:18px;

}


/* =========================
   FLORES
========================= */

.flor{

    position:absolute;

    font-size:38px;

    z-index:4;

    filter:
        drop-shadow(
            0 0 8px
            rgba(255,200,0,.7)
        );

}


.flor1{

    top:-22px;

    left:-15px;

}


.flor2{

    top:-20px;

    right:-15px;

}


.flor3{

    bottom:-20px;

    left:-12px;

}


.flor4{

    bottom:-20px;

    right:-12px;

}


/* =========================
   TARJETA DEL MENSAJE
========================= */

.carta{

    margin:
        35px
        auto;

    padding:
        28px
        22px;

    background:
        rgba(
            70,
            10,
            25,
            .65
        );

    border:
        1px solid
        rgba(
            255,
            215,
            150,
            .5
        );

    border-radius:22px;

    box-shadow:

        inset
        0 0 25px
        rgba(
            255,
            100,
            100,
            .15
        ),

        0 10px 30px
        rgba(0,0,0,.5);

    backdrop-filter:blur(5px);

}


/* TITULO DEL MENSAJE */

.carta h2{

    color:#ffd98a;

    font-size:28px;

    margin-bottom:18px;

}


/* TEXTO */

.carta p{

    font-size:18px;

    line-height:1.7;

    color:#fff1f3;

    margin-bottom:15px;

}


/* =========================
   FIRMA
========================= */

.firma{

    margin-top:22px;

    font-size:27px;

    color:#ffb7c5;

}


/* =========================
   TE AMO BOMBÓN
========================= */

.bombon{

    display:inline-block;

    margin-top:14px;

    font-size:31px;

    color:#ffd36b;

    text-shadow:

        0 0 8px #ff9d00,

        0 0 18px #ff5c7a;

    animation:
        brilloBombon 2s infinite alternate;

}


@keyframes brilloBombon{

    from{
        transform:scale(1);
    }

    to{
        transform:scale(1.08);
    }

}


/* =========================
   CORAZONES FLOTANTES
========================= */

.flotantes span{

    position:fixed;

    bottom:-50px;

    font-size:25px;

    animation:
        subir 7s linear infinite;

    opacity:.8;

    z-index:1;

}


.flotantes span:nth-child(1){

    left:10%;

    animation-delay:0s;

}


.flotantes span:nth-child(2){

    left:30%;

    animation-delay:2s;

}


.flotantes span:nth-child(3){

    left:55%;

    animation-delay:4s;

}


.flotantes span:nth-child(4){

    left:80%;

    animation-delay:1s;

}


@keyframes subir{

    0%{

        transform:
            translateY(0)
            scale(.7);

        opacity:0;

    }


    20%{

        opacity:1;

    }


    100%{

        transform:
            translateY(-110vh)
            scale(1.4)
            rotate(20deg);

        opacity:0;

    }

}


/* =========================
   FINAL
========================= */

.final{

    margin-top:30px;

    font-size:18px;

    line-height:1.7;

    color:#ffdce3;

}


.nombres{

    font-size:25px;

    color:#ffd36b;

    text-shadow:
        0 0 10px #ff9d00;

}


/* =========================
   CELULAR
========================= */

@media(max-width:500px){

    .titulo{

        font-size:34px;

    }


    .subtitulo{

        font-size:21px;

    }


    .carta p{

        font-size:17px;

    }


    .firma{

        font-size:25px;

    }


    .bombon{

        font-size:29px;

    }

}

</style>

</head>


<body>


<!-- =========================
     LUCES
========================= -->

<div class="luces">

    <div class="luz"></div>
    <div class="luz"></div>
    <div class="luz"></div>
    <div class="luz"></div>
    <div class="luz"></div>
    <div class="luz"></div>
    <div class="luz"></div>
    <div class="luz"></div>

</div>



<!-- =========================
     CORAZONES FLOTANDO
========================= -->

<div class="flotantes">

    <span>❤️</span>
    <span>💗</span>
    <span>❤️</span>
    <span>💕</span>

</div>



<!-- =========================
     CONTENIDO
========================= -->

<div class="contenedor">


    <!-- TITULO -->

    <div class="titulo">

        Feliz un mes más de relación

    </div>


    <div class="subtitulo">

        mi hermosa Fer ❤️

    </div>


    <div class="corazon">

        ❤️

    </div>



    <!-- =========================
         FOTO CENTRAL
    ========================= -->

    <div class="marco">


        <div class="flor flor1">
            🌻
        </div>


        <div class="flor flor2">
            🌹
        </div>


        <div class="flor flor3">
            🌹
        </div>


        <div class="flor flor4">
            🌻
        </div>


        <!--
        LA IMAGEN DEBE LLAMARSE:

        Tu y yo.jpg

        Y DEBE ESTAR EN LA MISMA CARPETA
        QUE index.html.
        -->

        <img
            src="Tu y yo.jpg"
            class="foto"
            alt="Fernanda y Jesús"
        >

    </div>



    <!-- =========================
         MENSAJE
========================= -->

    <div class="carta">


        <h2>

            Para ti, mi amor ❤️

        </h2>


        <p>

            Hoy celebramos un mes más
            de nuestra relación,
            y quiero que sepas lo feliz
            que me hace seguir compartiendo
            mi vida contigo.

        </p>


        <p>

            Gracias por cada sonrisa,
            cada abrazo, cada momento
            y cada recuerdo que hemos
            construido juntos.

        </p>


        <p>

            Quiero seguir viviendo
            muchos meses a tu lado,
            seguir creando recuerdos
            y disfrutando de todo
            lo bonito que nos queda
            por vivir.

        </p>



        <!-- FIRMA -->

        <div class="firma">

            Te amo, mi hermosa Fer ❤️

            <br>

            <span class="bombon">

                Te amo, bombón ❤️🍫

            </span>

        </div>


    </div>



    <!-- =========================
         FINAL
========================= -->

    <div class="final">


        <div class="nombres">

            ✨ Fernanda ❤️ Jesús ✨

        </div>


        <br>


        Un mes más juntos...


        <br>


        y muchos más por vivir ❤️


    </div>


</div>


</body>

</html>